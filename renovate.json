{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "enabledManagers": ["custom.regex"],
  "schedule": ["before 4am on monday"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dependencies\\.toml$/"
      ],
      "matchStrings": [
        "git\\s*=\\s*\"https://github\\.com/(?<depName>[^\"]+?)(?:\\.git)?\"\\s*\\n(?:[^\\n]*\\n){0,2}default\\s*=\\s*\\{\\s*tag\\s*=\\s*\"(?<currentValue>v[0-9][^\"]*)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dependencies\\.toml$/"
      ],
      "matchStrings": [
        "default\\s*=\\s*\\{\\s*tag\\s*=\\s*\"synapse-sdk-v(?<currentValue>[0-9][^\"]*)\""
      ],
      "depNameTemplate": "FilOzone/synapse-sdk",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^synapse-sdk-v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dependencies\\.toml$/"
      ],
      "matchStrings": [
        "default\\s*=\\s*\\{\\s*npm\\s*=\\s*\"(?<currentValue>[0-9][^\"]*)\""
      ],
      "depNameTemplate": "filecoin-pin",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
